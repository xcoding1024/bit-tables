{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "bit-tables.editor": ["./core/editor.ts"],
      "bit-tables.checker": ["./core/checker.ts"],
      "bit-tables.export": ["./core/export.ts"],
      "bit-tables.dom": ["./core/dom.ts"],
      "bit-tables.types": ["./core/types.ts"]
    }
  },
  "include": ["core/**/*.ts", "tables/**/*.ts"]
}
