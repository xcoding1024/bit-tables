{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "bit-tables.editor": ["./src/editor.ts"],
      "bit-tables.checker": ["./src/checker.ts"],
      "bit-tables.export": ["./src/export.ts"],
      "bit-tables.dom": ["./src/dom.ts"],
      "bit-tables.types": ["./src/types.ts"]
    }
  },
  "include": ["src/**/*.ts", "tables/**/*.ts"]
}
